# Streamlit Secrets template -- copy to .streamlit/secrets.toml (local) or
# paste into Streamlit Cloud's Manage app -> Secrets editor.
#
# Do NOT commit a real key. .streamlit/secrets.toml is gitignored by default
# in Streamlit projects; .streamlit/secrets.toml.example is the safe template.
#
# Default model is a free one so the deployment works without adding credits.
# Swap to gpt-4o-mini (or any other OpenRouter model id) once the account
# has credits.

OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "openai/gpt-oss-20b:free"
